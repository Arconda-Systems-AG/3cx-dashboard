      "pluginVersion": "12.2.0-16677249643",
      "targets": [
        {
          "dataset": "panagianbo",
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "-- Not answered CDRs\r\nWITH cdrs AS (\r\n  SELECT\r\n    c.cdr_id\r\n  FROM public_cdroutput AS c\r\n  LEFT JOIN public_cdroutput AS c_orig ON\r\n    c_orig.cdr_id = c.originating_cdr_id\r\n  WHERE $__timeFilter(c.cdr_started_at)\r\n  AND c.destination_entity_type = 'extension'\r\n  AND c.cdr_answered_at IS NULL\r\n  AND \r\n  (\r\n    c_orig.cdr_id IS NULL\r\n    OR NOT\r\n    (c.creation_forward_reason = 'polling' AND c_orig.destination_entity_type IN ('group', 'ring_group_ring_all', 'ring_group_hunt', 'queue'))\t\t-- Exclude polling\r\n  )\r\n  AND c.source_entity_type = 'external_line'\r\n),\r\n-- Intermediate step to rank callbacks\r\nranked_callbacks AS (\r\n  SELECT\r\n    c.main_call_history_id,\r\n    c.cdr_id AS original_cdr_id,\r\n    c.source_entity_type AS original_source_entity_type,\r\n    c.source_participant_phone_number AS original_source_participant_phone_number,\r\n    c.source_dn_name AS original_source_dn_name,\r\n    c.source_dn_number AS original_source_dn_number,\r\n    c.source_participant_trunk_did AS original_source_participant_trunk_did,\r\n    c.destination_entity_type AS original_destination_entity_type,\r\n    c.destination_participant_phone_number AS original_destination_participant_phone_number,\r\n    c.destination_dn_name AS original_destination_dn_name,\r\n    c.destination_dn_number AS original_destination_dn_number,\r\n    c.cdr_started_at AS original_started_at,\r\n    c.cdr_answered_at AS original_answered_at,\r\n    c.cdr_ended_at AS original_ended_at,\r\n    xcb.cdr_id AS xcb_cdr_id_val,\r\n    xcb.cdr_started_at AS xcb_started_at,\r\n    xcb.cdr_answered_at AS xcb_answered_at,\r\n    xcb.cdr_ended_at AS xcb_ended_at,\r\n    ROW_NUMBER() OVER (PARTITION BY xcb.destination_dn_number, xcb.destination_participant_phone_number ORDER BY xcb.cdr_id) as rn\r\n  FROM public_cdroutput AS c\r\n  INNER JOIN cdrs ON\r\n    cdrs.cdr_id = c.cdr_id\r\n  INNER JOIN public_cdroutput AS xcb ON\r\n    xcb.cdr_started_at > c.cdr_started_at\r\n    AND xcb.main_call_history_id != c.main_call_history_id\r\n    AND xcb.source_entity_type = c.destination_entity_type          -- Callback source is original call's destination\r\n    AND xcb.source_dn_number = c.destination_dn_number              -- Callback source DN is original call's destination DN\r\n    AND xcb.destination_entity_type = c.source_entity_type          -- Callback destination is original call's source\r\n    AND xcb.destination_participant_phone_number = c.source_participant_phone_number -- Callback destination phone is original call's source phone\r\n),\r\n-- Calls with explicit callbacks (filtered by rank)\r\ncalls_with_xcallbacks AS (\r\n  SELECT\r\n    rc.main_call_history_id,\r\n    rc.original_cdr_id AS cdr_id,\r\n    CASE\r\n      WHEN rc.original_source_entity_type = 'external_line'\r\n        THEN CONCAT(rc.original_source_participant_phone_number, ' ', coalesce(rc.original_source_dn_name, 'Unknown'))\r\n      ELSE CONCAT(rc.original_source_dn_number, ' ', coalesce(rc.original_source_dn_name, 'Unknown'))\r\n    END AS source_participant,\r\n    coalesce(rc.original_source_participant_trunk_did, 'Unknown') AS did,\r\n    CASE\r\n      WHEN rc.original_destination_entity_type = 'external_line'\r\n        THEN CONCAT(rc.original_destination_participant_phone_number, ' ', coalesce(rc.original_destination_dn_name, 'Unknown'))\r\n      ELSE CONCAT(rc.original_destination_dn_number, ' ', coalesce(rc.original_destination_dn_name, 'Unknown'))\r\n    END AS destination_participant,\r\n    rc.original_started_at AS started_at,\r\n    TIMESTAMPDIFF(SECOND, rc.original_started_at, coalesce(rc.original_answered_at, rc.original_ended_at)) AS ringing_duration,\r\n    CASE\r\n      WHEN TIMESTAMPDIFF(SECOND, rc.original_ended_at, rc.xcb_started_at) <= 86400\r\n        THEN '✅'\r\n      ELSE '❌'\r\n    END AS xcb_made,\r\n    rc.xcb_cdr_id_val AS xcb_cdr_id,\r\n    CASE WHEN rc.xcb_answered_at IS NOT NULL THEN 'Successful' ELSE 'Failed' END AS xcb_status,\r\n    CASE WHEN rc.xcb_answered_at IS NOT NULL THEN TIMESTAMPDIFF(SECOND, rc.xcb_started_at, rc.xcb_ended_at) END AS xcb_talking_duration\r\n  FROM ranked_callbacks rc\r\n  WHERE rc.rn = 1\r\n)\r\nSELECT c.*\r\nFROM calls_with_xcallbacks AS c\r\nUNION ALL\r\nSELECT\r\n  c.main_call_history_id,\r\n  c.cdr_id,\r\n  CASE\r\n    WHEN c.source_entity_type = 'external_line'\r\n      THEN CONCAT(c.source_participant_phone_number, ' ', coalesce(c.source_dn_name, 'Unknown'))\r\n    ELSE CONCAT(c.source_dn_number, ' ', coalesce(c.source_dn_name, 'Unknown'))\r\n  END AS source_participant,\r\n  coalesce(c.source_participant_trunk_did, 'Unknown') AS did,\r\n  CASE\r\n    WHEN c.destination_entity_type = 'external_line'\r\n      THEN CONCAT(c.destination_participant_phone_number, ' ', coalesce(c.destination_dn_name, 'Unknown'))\r\n    ELSE CONCAT(c.destination_dn_number, ' ', coalesce(c.destination_dn_name, 'Unknown'))\r\n  END AS destination_participant,\r\n  c.cdr_started_at AS started_at,\r\n  TIMESTAMPDIFF(SECOND, c.cdr_started_at, coalesce(c.cdr_answered_at, c.cdr_ended_at)) AS ringing_duration,\r\n  '❌' AS xcb_made,\r\n  NULL AS xcb_cdr_id,\r\n  'No callbacks made' AS xcb_status,\r\n  CAST(NULL AS UNSIGNED INTEGER) AS xcb_talking_duration\r\nFROM public_cdroutput AS c\r\nINNER JOIN cdrs ON\r\n  cdrs.cdr_id = c.cdr_id\r\nWHERE NOT EXISTS (\r\n  SELECT 1 FROM calls_with_xcallbacks AS x WHERE x.cdr_id = c.cdr_id\r\n)\r\nORDER BY started_at DESC\r\n;",
          "refId": "A",
