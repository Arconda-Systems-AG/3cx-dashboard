      "pluginVersion": "12.2.0-16677249643",
      "targets": [
        {
          "editorMode": "code",
          "format": 1,
          "location": "",
          "project": "pbx-26350568",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  rec.start_time,\r\n  ------------------------------------------------------------------------------\r\n  -- This pattern can be used to extract only the file name without the subpath.\r\n  -- CASE\r\n  --   WHEN STRPOS(rec.recording_url, '/') > 0\r\n  --     THEN REGEXP_EXTRACT(rec.recording_url, r'^.*/(.*)$')\r\n  --   ELSE rec.recording_url\r\n  -- END AS rec_file_name,\r\n  ------------------------------------------------------------------------------\r\n  rec.recording_url AS file_name,\r\n  coalesce(TIMESTAMP_DIFF(rec.end_time, rec.start_time, SECOND), 0) AS duration_sec,\r\n  rp_from.caller_number || ' ' || coalesce(rp_from.display_name, 'Unknown') AS caller,\r\n  CASE\r\n    WHEN rp_to.caller_number != rp_to.display_name\r\n      THEN rp_to.caller_number || ' '\r\n    ELSE ''\r\n  END || coalesce(rp_to.display_name, 'Unknown') AS callee,\r\n  rec.transcription,\r\n  rec.summary,\r\n  rec.sentiment_score\r\nFROM `3cx_call_data.public_recordings` AS rec\r\nINNER JOIN `3cx_call_data.public_recording_participant` AS rp_from ON\r\n  rp_from.fk_recording_url = rec.recording_url\r\n  AND rp_from.is_from\r\nINNER JOIN `3cx_call_data.public_recording_participant` AS rp_to ON\r\n  rp_to.fk_recording_url = rec.recording_url\r\n  AND NOT rp_to.is_from\r\n------------------------------------------------------------------------------\r\n-- Can be used to extract call information\r\n-- LEFT JOIN `3cx_call_data.public_cdroutput` AS c ON\r\n--   c.cdr_id = rec.cdr_id\r\n------------------------------------------------------------------------------\r\nWHERE $__timeFilter(rec.start_time)\r\nORDER BY rec.start_time DESC\r\n;",
